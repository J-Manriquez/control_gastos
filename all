  try {
    await FirestoreService().initialize();
  } on FirebaseException catch (e) {
    CustomLogger().logError(
        "Error durante la inicialización de Firebase: ${e.message} (code: ${e.code})");
    return;
  } catch (e) {
    CustomLogger().logError("Error inesperado: $e");
